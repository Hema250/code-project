#logistic regression
ads<-c(10,20,30,40,50)
sales<-c(200,350,500,620,700)

  #if(sales>500){
   # 1
  #}else{
   #0}

high_sales<-ifelse(sales>500,1,0)

data<-data.frame(ads,sales,high_sales)
data

model_logistic<-glm(high_sales~ads,
                    data=data,
                    family=binomial())

summary(model_logistic)

ifelse(predict(model_logistic,data.frame(ads=35),
               type="response")>0.5,"YES","NO")

plot(ads,high_sales,
     pch=16,col="skyblue",
     xlab="ads",
     ylab="High sales(0/1)",
     main="Logistic regression curve")

curve(predict(model_logistic,
              data.frame(ads=x),
              type="response"),
add=TRUE,
col="blue",
lwd=2)


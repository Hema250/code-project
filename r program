movie<-c(50,30,15,5)
preference<-c("5 stars","4 stars","3 stars","2 stars")
percent<-round(movie/sum(movie)*100)

labels<-paste(preference,percent,"%")
pie(movie,
    labels=labels,
    clockwise=TRUE,
    main="Avatar movie rating analysis ",
    col=c("gold","lightgreen","orange","red"),
)     

